# 本地 wrangler dev 用的环境变量模板：复制为 .dev.vars 后填入真实值。
# .dev.vars 已被 gateway/.gitignore 忽略，绝不提交；真实 key 绝不写进任何会被提交的文件。

# BigModel（智谱）API Key：只在终端 wrangler secret put 或本地 .dev.vars 里粘贴。
GLM_API_KEY=your-bigmodel-api-key-placeholder

# 跨域白名单（逗号分隔）。生产环境用 wrangler.toml [vars] 或 dashboard 配置；
# 未配置 = 拒绝所有跨域请求（fail-closed），仅 health 例外。
# 条目自动归一到 scheme+host+port，写 Pages 子路径也可以。
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5177

# 模型覆写：必须在 src/config.ts 的 GLM_MODEL_WHITELIST 内，否则回落 glm-5.3-flash。
GLM_MODEL=glm-5.3-flash

# 思考模式覆写：glm-5.3-flash 是思考模型；disabled 保证 30s 客户端超时内出正文。
GLM_THINKING=disabled

# 可选：防滥用参数
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60
QUOTA_DAILY_MAX=200
