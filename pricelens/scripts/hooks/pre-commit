#!/bin/sh
# ============================================================
# PriceLens 提交前防线（第十八轮）：typecheck → verify → test → build。
# 启用（仓库根目录执行一次）：git config core.hooksPath pricelens/scripts/hooks
# 临时跳过：SKIP_CHECK=1 git commit …（仅限纯文档/注释类提交）
# ============================================================
if [ -n "$SKIP_CHECK" ]; then
  echo "[pre-commit] SKIP_CHECK=1，跳过校验"
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT/pricelens" || exit 1

echo "[pre-commit] 1/4 typecheck"
npm run --silent typecheck || exit 1

echo "[pre-commit] 2/4 verify（造数与聚合契约断言）"
npm run --silent verify || exit 1

echo "[pre-commit] 3/4 test（chartModel 金测）"
npm run --silent test || exit 1

echo "[pre-commit] 4/4 build（单文件交付产物）"
npm run --silent build || exit 1

echo "[pre-commit] 全部通过 ✓"
