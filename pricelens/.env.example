# Optional same-origin proxy for Ark Agent Plan speech transcription.
# Keep ARK API keys on the server; never put them in VITE_* variables.
VITE_ARK_VOICE_PROXY=/api/agent/voice

# Optional remote Agent SSE endpoint. The current branch falls back to the
# deterministic local adapter when it is not configured.
VITE_AGENT_API_BASE_URL=/api/agent
