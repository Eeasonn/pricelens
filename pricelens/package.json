{
  "name": "pricelens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/sync-single.mjs",
    "build:iterate": "VITE_APP_CHANNEL=iterate vite build",
    "build:channels": "node scripts/build_channels.mjs",
    "preview": "vite preview",
    "agent-server": "node server/agent-server.mjs",
    "gen": "echo '[deprecated] 造数脚本已被真实数据接入取代：npm run ingest' && node scripts/gen-data.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:channels": "node scripts/verify_channels.mjs",
    "test": "vitest run",
    "design:check": "node scripts/design-check.mjs",
    "design:lint": "node scripts/design-lint.mjs",
    "design:detect": "node scripts/impeccable-detect.mjs",
    "check": "npm run design:check && npm run design:lint && npm run typecheck && npm run verify && npm run test && npm run build",
    "ingest": "python3 scripts/ingest_real.py",
    "ingest:za": "python3 scripts/ingest_za_booklet.py",
    "review:za": "python3 scripts/review_za_booklet.py"
  },
  "dependencies": {
    "antd": "^5.21.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "fflate": "^0.8.3",
    "gsap": "^3.15.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "impeccable": "4.8.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-singlefile": "^2.0.2",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
